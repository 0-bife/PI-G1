/* Lógico_1: */

CREATE TABLE CONTATO (
    cadastrado_em DATE,
    nome VARCHAR,
    telefone VARCHAR,
    email VARCHAR,
    id_contato NUMERIC PRIMARY KEY,
    FK_CONVERSA_id_conversa NUMERIC
);

CREATE TABLE ETIQUETA (
    id_etiqueta NUMERIC PRIMARY KEY,
    cor VARCHAR,
    nome VARCHAR
);

CREATE TABLE CONVERSA (
    criada_em DATE,
    id_conversa NUMERIC PRIMARY KEY,
    FK_MENSAGEM_id_mensagem NUMERIC,
    FK_ANOTACAO_INTERNA_id_anotacao NUMERIC,
    FK_ATENDIMENTO_id_atendimento NUMERIC
);

CREATE TABLE MENSAGEM (
    data_hora TIMESTAMP,
    conteudo VARCHAR,
    origem VARCHAR,
    status VARCHAR,
    referencia_midia VARCHAR,
    id_mensagem NUMERIC PRIMARY KEY,
    tipo VARCHAR,
    id_externo NUMERIC
);

CREATE TABLE ANOTACAO_INTERNA (
    texto VARCHAR,
    id_anotacao NUMERIC PRIMARY KEY,
    criada_em TIMESTAMP
);

CREATE TABLE ATENDIMENTO (
    id_atendimento NUMERIC PRIMARY KEY,
    status VARCHAR,
    encerrado_em TIMESTAMP,
    prazo_retorno TIME,
    iniciado_em TIMESTAMP,
    FK_ATRIBUICAO_id_atribuicao NUMERIC
);

CREATE TABLE USUARIO (
    ativo BOOLEAN,
    id_usuario NUMERIC PRIMARY KEY,
    nome VARCHAR,
    hash_senha VARCHAR,
    email VARCHAR,
    FK_MENSAGEM_id_mensagem NUMERIC,
    FK_ANOTACAO_INTERNA_id_anotacao NUMERIC,
    FK_ATRIBUICAO_id_atribuicao NUMERIC
);

CREATE TABLE ATRIBUICAO (
    encerrada_em DATE,
    iniciada_em DATE,
    id_atribuicao NUMERIC PRIMARY KEY
);

CREATE TABLE classifica (
    fk_CONTATO_id_contato NUMERIC,
    fk_ETIQUETA_id_etiqueta NUMERIC
);

CREATE TABLE marca (
    fk_ETIQUETA_id_etiqueta NUMERIC,
    fk_CONVERSA_id_conversa NUMERIC
);
 
