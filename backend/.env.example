HOST=127.0.0.1 # endereço do servidor back-end   
PORT=3000 # porta do servidor back-end
DB_HOST=127.0.0.1 # endereço do servidor de banco de dados
DB_PORT=3306 # porta do servidor de banco de dados
DB_USER=inablink # usuário do banco de dados
DB_PASSWORD=change-me  # senha do usuário do banco de dados
DB_NAME=inablink # nome do DATABASE
DB_SSL=true # habilita SSL para conexão com o banco de dados
JWT_SECRET= # chave secreta para assinatura de tokens JWT
CORS_ORIGINS= #origens do front-end que podem acessar a API (ex.: http://localhost:5173)
WHATSAPP_ACCESS_TOKEN= # token de acesso à API do WhatsApp
WHATSAPP_PHONE_NUMBER_ID= # ID do número de telefone do WhatsApp
WHATSAPP_VERIFY_TOKEN= # token de verificação para webhook do WhatsApp
WHATSAPP_APP_SECRET= # segredo do aplicativo do WhatsApp
WHATSAPP_API_VERSION= # versão da API do WhatsApp (ex.: v13.0)
BUSINESS_HOURS_START=10:00 # início do horário comercial (HH:MM)
BUSINESS_HOURS_END=22:00 # fim do horário comercial (HH:MM)
AUTO_REPLY_CONFIG_PATH= # caminho opcional para JSON de configuração de atendimento automático
